{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metups-whatsapp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-18",
  "observability": {
    "enabled": true
  },
  "env": {
    "development": {
      "name": "metups-whatsapp-development",
      "vars": {
        "ENVIRONMENT": "development",
        "SESSION_TTL_MINUTES": "30"
      }
    },
    "production": {
      "name": "metups-whatsapp",
      "vars": {
        "ENVIRONMENT": "production",
        "SESSION_TTL_MINUTES": "30"
      }
    }
  }
}
