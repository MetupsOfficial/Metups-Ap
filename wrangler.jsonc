{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metupsapp",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-18",
  "assets": {
    "directory": "src",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
